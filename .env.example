OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Harvest store (append-only, every Autocomplete/Trends result): local SQLite unless DATABASE_URL is set
# HARVEST_DB_PATH=.cache/harvest.sqlite
# Local API runs: skip the Cognito check (never set in AWS). Jobs are kept in memory unless DATABASE_URL is set.
# AUTH_DISABLED=1
# DATABASE_URL=postgresql://user:pass@localhost:5432/atrion   # jobs + harvest store in PostgreSQL
